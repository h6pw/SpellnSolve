{
  "name": "spellnsolve",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/version.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint .",
    "test:ci": "vitest run --coverage",
    "test:e2e": "playwright test",
    "gdd:pdf": "python scripts/gdd.py",
    "package": "python scripts/package.py",
    "validate": "npm run lint && npm run test:ci && npm run build && npm run test:e2e",
    "content:validate": "node scripts/validate-content.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.13.1 <25",
    "npm": ">=11 <12"
  }
}
